{{!
    @template block_aicourserecommender/path_card

    Card of a recommended learning path.

    Context variables required for this template:
    * uniqid - Unique id of the block
    * id, position, name, image, coursecounttext, reason, viewurl
    * ratedup, rateddown - Current rating of the user

    Example context (json):
    {
        "uniqid": "aicr123",
        "type": "path", "id": 1, "position": 1, "name": "Leadership path", "image": "https://example.com/p.png",
        "coursecount": 3, "coursecounttext": "3 courses", "reason": "A step by step route to lead teams.",
        "score": 80, "viewurl": "https://example.com/blocks/aicourserecommender/path.php?id=1",
        "rating": 0, "ratedup": false, "rateddown": false
    }
}}
<article class="aicr-card aicr-card-path card h-100" data-region="card" data-itemtype="path" data-itemid="{{id}}"
    data-position="{{position}}" aria-labelledby="{{uniqid}}-path-{{id}}-name">
    <img src="{{image}}" alt="" class="aicr-card-img" loading="lazy">
    <div class="card-body aicr-card-body">
        <p class="aicr-badge small mb-1">{{#str}} learningpath, block_aicourserecommender {{/str}} · {{coursecounttext}}</p>
        <h4 class="h6 aicr-card-title" id="{{uniqid}}-path-{{id}}-name">{{name}}</h4>
        {{#reason}}
        <p class="aicr-reason small">
            <strong>{{#str}} whyrecommended, block_aicourserecommender {{/str}}</strong>
            {{reason}}
        </p>
        {{/reason}}
        <div class="aicr-actions">
            <a class="btn btn-outline-primary btn-sm" href="{{viewurl}}" data-action="view"
                aria-describedby="{{uniqid}}-path-{{id}}-name">{{#str}} viewpath, block_aicourserecommender {{/str}}</a>
        </div>
        {{> block_aicourserecommender/rating }}
    </div>
</article>
