{{!
    @template block_aicourserecommender/report_totals

    Totals of the usage report.

    Context variables required for this template:
    * totals - key, label, value

    Example context (json):
    {
        "totals": [
            {"key": "users", "label": "Learners with answers", "value": "12"},
            {"key": "ctr", "label": "Click-through rate", "value": "8.5 %"}
        ]
    }
}}
<dl class="aicr-totals mb-4">
    {{#totals}}
    <div class="aicr-total card" data-total="{{key}}">
        <dt class="small text-muted">{{label}}</dt>
        <dd class="h4 mb-0">{{value}}</dd>
    </div>
    {{/totals}}
</dl>
