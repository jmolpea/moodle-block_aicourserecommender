{{!
    @template block_aicourserecommender/rating

    Thumbs up / thumbs down rating of a recommendation, with an optional reason for thumbs down.

    Context variables required for this template:
    * uniqid - Unique id of the block
    * type - course or path
    * id - Item id
    * ratedup, rateddown - Current rating

    Example context (json):
    {
        "uniqid": "aicr123", "type": "course", "id": 2, "ratedup": false, "rateddown": false
    }
}}
<div class="aicr-rating" data-region="rating">
    <div class="aicr-rating-buttons" role="group" aria-label="{{#str}} rateitem, block_aicourserecommender {{/str}}">
        <button type="button" class="btn btn-sm btn-outline-secondary aicr-rate" data-action="rate" data-rating="1"
            aria-pressed="{{#ratedup}}true{{/ratedup}}{{^ratedup}}false{{/ratedup}}"
            title="{{#str}} rateuseful, block_aicourserecommender {{/str}}">
            <span aria-hidden="true">&#128077;</span>
            <span class="sr-only visually-hidden">{{#str}} rateuseful, block_aicourserecommender {{/str}}</span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary aicr-rate" data-action="rate" data-rating="-1"
            aria-pressed="{{#rateddown}}true{{/rateddown}}{{^rateddown}}false{{/rateddown}}"
            title="{{#str}} ratenotuseful, block_aicourserecommender {{/str}}">
            <span aria-hidden="true">&#128078;</span>
            <span class="sr-only visually-hidden">{{#str}} ratenotuseful, block_aicourserecommender {{/str}}</span>
        </button>
    </div>
    <div class="aicr-reason-form mt-2" data-region="reason-form" hidden>
        <label for="{{uniqid}}-{{type}}-{{id}}-why" class="small">{{#str}} whynotfit, block_aicourserecommender {{/str}}</label>
        <div class="aicr-reason-row">
            <input type="text" class="form-control form-control-sm" id="{{uniqid}}-{{type}}-{{id}}-why" maxlength="200"
                data-region="reason-input">
            <button type="button" class="btn btn-sm btn-secondary" data-action="send-reason">
                {{#str}} send, block_aicourserecommender {{/str}}
            </button>
        </div>
    </div>
    <span class="small text-muted" data-region="rating-status" aria-live="polite"></span>
</div>
