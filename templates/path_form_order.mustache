{{!
    @template block_aicourserecommender/path_form_order

    Container of the course order list in the learning path form. JavaScript fills it.

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div class="aicr-course-order" data-region="course-order">
    <p class="small text-muted" data-region="course-order-empty">{{#str}} pathcourseorder_empty, block_aicourserecommender {{/str}}</p>
    <ol class="list-group" data-region="course-order-list"></ol>
    <div class="sr-only visually-hidden" aria-live="polite" data-region="course-order-live"></div>
</div>
