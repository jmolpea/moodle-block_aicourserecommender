{{!
    @template block_aicourserecommender/mic_button

    Voice dictation button. It writes into the textarea of the same question card. Hidden until JavaScript
    confirms that the browser supports speech recognition.

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<button type="button" class="btn btn-sm aicr-mic" data-action="dictate" aria-pressed="false" hidden>
    <svg class="aicr-mic-icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
        <path fill="currentColor" d="M8 10a2.5 2.5 0 0 0 2.5-2.5v-4a2.5 2.5 0 0 0-5 0v4A2.5 2.5 0 0 0 8 10zm4-2.5
            a.5.5 0 0 1 1 0A5 5 0 0 1 8.5 12.47V14h2a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1h2v-1.53A5 5 0 0 1 3 7.5
            a.5.5 0 0 1 1 0 4 4 0 0 0 8 0z"/>
    </svg>
    <span data-region="mic-label">{{#str}} dictate, block_aicourserecommender {{/str}}</span>
</button>
