{{!
    @template block_aicourserecommender/noprovider

    Notice for administrators when no AI provider offers text generation.

    Context variables required for this template:
    * url - AI providers settings URL

    Example context (json):
    {
        "url": "https://example.com/admin/settings.php?section=aiprovider"
    }
}}
<div class="alert alert-warning small mb-0" role="status">
    {{#str}} noprovideradmin, block_aicourserecommender {{/str}}
    <a href="{{url}}">{{#str}} configureai, block_aicourserecommender {{/str}}</a>
</div>
