{{!
    @template block_aicourserecommender/results

    Recommendation results: courses and learning paths in two sections.

    Context variables required for this template:
    * uniqid - Unique id of the block
    * notice - Optional notice
    * courses - Course cards
    * paths - Path cards
    * hascourses, haspaths - Whether each section has items
    * hasmorecourses, hasmorepaths - Whether "See more" is shown

    Example context (json):
    {
        "uniqid": "aicr123",
        "notice": "",
        "hascourses": true,
        "haspaths": true,
        "hasmorecourses": true,
        "hasmorepaths": false,
        "courses": [{
            "type": "course", "id": 2, "position": 1, "name": "Project management", "plainname": "Project management",
            "category": "Management",
            "image": "https://example.com/image.png", "startdate": "1 October 2026", "enddate": "", "hasdates": true,
            "reason": "It matches your goal of leading projects.", "score": 90,
            "viewurl": "https://example.com/course/view.php?id=2", "canenrol": true, "rating": 0,
            "ratedup": false, "rateddown": false
        }],
        "paths": [{
            "type": "path", "id": 1, "position": 1, "name": "Leadership path", "image": "https://example.com/p.png",
            "coursecount": 3, "coursecounttext": "3 courses", "reason": "A step by step route to lead teams.",
            "score": 80, "viewurl": "https://example.com/blocks/aicourserecommender/path.php?id=1",
            "rating": 0, "ratedup": false, "rateddown": false
        }]
    }
}}
{{#notice}}
<div class="alert alert-info small" role="status">{{notice}}</div>
{{/notice}}
{{#hascourses}}
<section class="aicr-section" aria-labelledby="{{uniqid}}-courses-title" data-region="section-course">
    <h3 id="{{uniqid}}-courses-title" class="h6 aicr-section-title">{{#str}} coursesforyou, block_aicourserecommender {{/str}}</h3>
    <ul class="aicr-grid list-unstyled" data-region="list-course">
        {{#courses}}
        <li>{{> block_aicourserecommender/course_card }}</li>
        {{/courses}}
    </ul>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="more" data-itemtype="course"
        {{^hasmorecourses}}hidden{{/hasmorecourses}}>
        {{#str}} seemorecourses, block_aicourserecommender {{/str}}
    </button>
</section>
{{/hascourses}}
{{#haspaths}}
<section class="aicr-section" aria-labelledby="{{uniqid}}-paths-title" data-region="section-path">
    <h3 id="{{uniqid}}-paths-title" class="h6 aicr-section-title">{{#str}} pathsforyou, block_aicourserecommender {{/str}}</h3>
    <ul class="aicr-grid list-unstyled" data-region="list-path">
        {{#paths}}
        <li>{{> block_aicourserecommender/path_card }}</li>
        {{/paths}}
    </ul>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="more" data-itemtype="path"
        {{^hasmorepaths}}hidden{{/hasmorepaths}}>
        {{#str}} seemorepaths, block_aicourserecommender {{/str}}
    </button>
</section>
{{/haspaths}}
<div class="aicr-footer">
    <button type="button" class="btn btn-link btn-sm p-0" data-action="change-interests">
        {{#str}} changeinterests, block_aicourserecommender {{/str}}
    </button>
    <button type="button" class="btn btn-link btn-sm p-0" data-action="delete-data">
        {{#str}} deletemydata, block_aicourserecommender {{/str}}
    </button>
</div>
